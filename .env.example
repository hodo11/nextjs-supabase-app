# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Resend(이메일 발송). 미설정 시 공지/정산/리마인드 메일 발송은 건너뛰고 저장만 진행한다.
# https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="모임 매니저 <notice@example.com>"

# 메일 본문의 절대 링크 생성용(예: https://my-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 리마인드 cron 엔드포인트(app/api/cron/reminders) 인증용 공유 비밀값
CRON_SECRET=

# service-role 키(RLS 우회, 서버 전용). 리마인드 cron처럼 사용자 세션이 없는 작업에서만 사용한다.
# https://app.supabase.com/project/_/settings/api -> service_role secret
# 절대 NEXT_PUBLIC_* 접두어를 붙이지 않는다(클라이언트에 노출되면 안 됨).
SUPABASE_SERVICE_ROLE_KEY=
